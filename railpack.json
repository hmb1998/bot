{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "buildAptPackages": ["git"],
  "packages": {
    "python": "3.12",
    "node": "22"
  },
  "steps": {
    "bgutil": {
      "inputs": [
        { "step": "build" }
      ],
      "commands": [
        "rm -rf bgutil-ytdlp-pot-provider",
        "git clone --depth 1 --branch 1.3.1 https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git bgutil-ytdlp-pot-provider",
        "cd bgutil-ytdlp-pot-provider/server && npm ci --no-audit --no-fund && npx tsc"
      ],
      "deployOutputs": [
        "bgutil-ytdlp-pot-provider"
      ]
    }
  },
  "deploy": {
    "aptPackages": ["ffmpeg"],
    "startCommand": "sh -c 'node bgutil-ytdlp-pot-provider/server/build/main.js >/tmp/bgutil-pot.log 2>&1 & exec python main.py'"
  }
}
